# Copy to supabase/.env (gitignored). Read by `supabase start` for config.toml env(...) values.
# Native Sign in with Apple only needs the id-token audience (client_id in config.toml); GoTrue still wants a
# non-empty secret for the provider, so any placeholder works until you add the web (OAuth) flow.
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=unused-native-flow-only
