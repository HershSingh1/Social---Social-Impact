EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Obtain from the team's Expo project. Public identifier, not an access token.
EAS_PROJECT_ID=YOUR-EAS-PROJECT-UUID
# Optional for now (backlogged, TEC-103): without it the Android map is blank; iOS is unaffected.
# When added, restrict it to com.sidequest.app and the development signing certificate SHA-1.
# GOOGLE_MAPS_ANDROID_API_KEY=YOUR-ANDROID-MAPS-KEY
